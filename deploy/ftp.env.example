# Copy to deploy/ftp.env (not in git). No passwords here: they are asked at the prompt.
FTP_HOST=ftp.k-city.it
FTP_USER=
FTP_DIR=/www.k-city.eu
SITE_URL=https://www.k-city.eu
# Set to "no" only if lftp rejects Aruba's FTP certificate (hostname mismatch).
FTP_VERIFY_CERT=yes
# Extra server files to keep, space separated (e.g. the real Google verification file).
KEEP_EXTRA=""
